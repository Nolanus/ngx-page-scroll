{
  "name": "ngx-page-scroll-demo",
  "version": "0.0.0",
  "scripts": {
    "build": "ng build",
    "build:app": "ng build --configuration production",
    "build:lib": "ng build ngx-page-scroll-core --configuration production && ng build ngx-page-scroll --configuration production && npm run copy:readme",
    "copy:readme": "copyfiles README.md dist/ngx-page-scroll && copyfiles README.md dist/ngx-page-scroll-core",
    "commit": "git-cz",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "lint": "ng lint",
    "ng": "ng",
    "prerelease:lib": "ng lint && ng test --no-watch && npm run build:lib",
    "release:lib": "cd dist/ngx-page-scroll-core && npm publish && cd ../ngx-page-scroll && npm publish",
    "start": "ng serve",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.6",
    "@angular/cdk": "^22.0.4",
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/material": "^22.0.4",
    "@angular/platform-browser": "^22.0.6",
    "@angular/platform-browser-dynamic": "^22.0.6",
    "@angular/router": "^22.0.6",
    "normalize.css": "^8.0.1",
    "rxjs": "~7.5.2",
    "tslib": "^2.6.2",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.6",
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "@commitlint/cli": "^12.1.4",
    "@commitlint/config-conventional": "^12.1.4",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.28.0",
    "@types/jasmine": "^3.6.3",
    "@types/node": "^22.12.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "angular-eslint": "^22.1.0",
    "commitizen": "^4.2.4",
    "copyfiles": "^2.4.1",
    "cypress": "^15.5.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.28.0",
    "husky": "^6.0.0",
    "jasmine-core": "~4.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.1",
    "karma-jasmine-html-reporter": "^1.7.0",
    "ng-packagr": "^22.0.1",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "wait-on": "^8.0.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  }
}
